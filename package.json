{
  "name": "dungeon-crawler",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sim": "jiti scripts/sim-balance.ts",
    "narration": "bash scripts/narration/record.sh",
    "deploy:canoe": "bash scripts/deploy-canoe.sh",
    "native:build": "vite build --config vite.native.config.ts",
    "native:sync": "npm run native:build && cap sync",
    "native:ios": "npm run native:sync && cap open ios"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "bcryptjs": "^3.0.3",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "phaser": "^3.90.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^7.4.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
